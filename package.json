{
  "name": "custom-bingo-maker",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env --clear-screen=false src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/src/index.js",
    "prettier:run": "prettier --write .",
    "prettier:watch": "onchange \"**/*\" --exclude-path .prettierignore -- prettier --write --ignore-unknown {{changed}}",
    "db:generate": "npx --env-file=.env drizzle-kit generate --config ./drizzle.config.ts",
    "db:migrate": "npx --env-file=.env drizzle-kit migrate --config ./drizzle.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "drizzle-kit": "^0.31.11",
    "onchange": "^7.1.0",
    "prettier": "3.9.10",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
